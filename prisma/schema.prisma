generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EducationLevel {
  PRIMARY
  HIGH_SCHOOL
  HIGH_SCHOOL_GRADUATION
  BACHELOR
  MASTER
  PHD
}

enum AdminStatus {
  NEW
  CONTACTED
  SENT
  HIRED
  STARTED
  REJECTED
  UNAVAILABLE
}

model Candidate {
  id                    String            @id @default(cuid())
  firstName             String
  lastName              String
  email                 String            @unique
  phone                 String?
  city                  String
  desiredPosition       String
  totalExperienceMonths Int               @default(0)
  totalExperienceYears  Int               @default(0)
  hasDriversLicense     Boolean           @default(false)
  driversLicenseTypes   String[]          // A, B, C, D, BE, CE
  highestEducationLevel EducationLevel
  adminStatus           AdminStatus       @default(NEW)
  adminNote             String?
  gdprConsent           Boolean
  shareToken            String            @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workExperience        WorkExperience[]
  education             Education[]
  skills                CandidateSkill[]
  languages             CandidateLanguage[]
  certificates          Certificate[]
  attachments           Attachment[]

  @@index([totalExperienceYears])
  @@index([hasDriversLicense])
  @@index([highestEducationLevel])
  @@index([adminStatus])
  @@index([city])
  @@index([email])
  @@index([shareToken])
}

model WorkExperience {
  id          String    @id @default(cuid())
  candidateId String
  position    String
  company     String
  industry    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Education {
  id          String         @id @default(cuid())
  candidateId String
  level       EducationLevel
  school      String
  field       String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean        @default(false)

  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String           @id @default(cuid())
  name      String           @unique
  category  String?          // IT, Soft Skills, Other
  candidates CandidateSkill[]
}

model CandidateSkill {
  id          String    @id @default(cuid())
  candidateId String
  skillId     String

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model Language {
  id        String              @id @default(cuid())
  name      String              @unique
  candidates CandidateLanguage[]
}

model CandidateLanguage {
  id          String    @id @default(cuid())
  candidateId String
  languageId  String
  level       String    // A1, A2, B1, B2, C1, C2

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@index([languageId, level])
}

model Certificate {
  id           String    @id @default(cuid())
  candidateId  String
  name         String
  organization String
  year         Int

  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Attachment {
  id          String   @id @default(cuid())
  candidateId String
  fileName    String
  mimeType    String   // PDF, DOCX, etc.
  filePath    String
  fileSize    Int
  createdAt   DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
